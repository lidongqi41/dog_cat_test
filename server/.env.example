# 复制为 .env 后按需修改；.env 不要提交
DB_URL=jdbc:mysql://127.0.0.1:3306/warmpaws?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=warmpaws
DB_PASSWORD=warmpaws

PUBLIC_BASE_URL=http://127.0.0.1:8080
JWT_SECRET=warmpaws-dev-secret-please-change-32bytes-min
JWT_EXPIRE_SECONDS=604800

# true：本地不调微信接口，固定 mock-openid；正式版必须 false
AUTH_MOCK=true
WX_APPID=
WX_SECRET=

# local：本地磁盘 + /api/v1/files；cos：腾讯云对象存储
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/uploads
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_DOMAIN=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
