<navigation-bar title="暖爪 WarmPaws" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list">
  <view class="container">
    <view class="hero">
      <view class="hero__title">暖爪 WarmPaws</view>
      <view class="hero__desc">流浪动物救助 · 领养信息平台</view>
    </view>

    <view wx:if="{{loading && !notices.length}}" class="card">
      <page-state status="loading"></page-state>
    </view>

    <view wx:elif="{{error && !notices.length}}" class="card">
      <page-state status="error" text="{{error}}" bind:retry="load"></page-state>
    </view>

    <block wx:else>
      <view class="card" wx:if="{{notices.length}}">
        <view class="card__title">公告</view>
        <view
          wx:for="{{notices}}"
          wx:key="id"
          class="notice-item"
          bindtap="goNotice"
          data-id="{{item.id}}"
        >
          <view class="notice-item__title">{{item.title}}</view>
          <view class="notice-item__time">{{item.timeText}}</view>
        </view>
      </view>

      <view class="card">
        <view class="card__title">快速查找</view>
        <view class="chips">
          <view
            wx:for="{{quickFilters}}"
            wx:key="key"
            class="chip"
            bindtap="quickFilter"
            data-type="{{item.type}}"
            data-status="{{item.status}}"
          >{{item.label}}</view>
        </view>
        <button class="btn btn--ghost" bindtap="goSubmit">上报流浪动物</button>
      </view>

      <view class="section-title">等待领养</view>

      <view
        wx:for="{{animals}}"
        wx:key="id"
        class="animal-card"
        bindtap="goAnimal"
        data-id="{{item.id}}"
      >
        <view class="animal-card__cover">
          <image wx:if="{{item.cover}}" class="animal-card__img" src="{{item.cover}}" mode="aspectFill"></image>
          <text wx:else class="animal-card__emoji">{{item.type === 'cat' ? '🐱' : '🐶'}}</text>
        </view>
        <view class="animal-card__body">
          <view class="animal-card__name">{{item.name}}</view>
          <view class="animal-card__meta">{{item.breed}} · {{item.age}} · {{item.genderLabel}}</view>
          <view class="animal-card__foot">
            <text class="tag tag--{{item.statusColor}}">{{item.statusLabel}}</text>
            <text class="animal-card__loc">{{item.location}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!animals.length}}" class="tip">暂时没有待领养的动物。</view>

      <button class="btn btn--ghost" bindtap="goAllAnimals">查看全部动物</button>
    </block>
  </view>
</scroll-view>