<!--index.wxml-->
<navigation-bar title="流浪猫狗" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page">
    <view class="hero">
      <view class="hero__title">流浪猫狗 · 测试项目</view>
      <view class="hero__desc">微信小程序骨架 · Skyline 渲染引擎</view>
    </view>

    <view class="card">
      <view class="card__title">项目状态</view>
      <view class="row">
        <text class="row__key">版本</text>
        <text class="row__value">{{version}}</text>
      </view>
      <view class="row">
        <text class="row__key">渲染引擎</text>
        <text class="row__value">Skyline</text>
      </view>
      <view class="row">
        <text class="row__key">基础库</text>
        <text class="row__value">3.17.6</text>
      </view>
    </view>

    <button class="btn" bindtap="goDemo" hover-class="btn--active">查看页面跳转示例</button>

    <view class="tip">这是骨架阶段：首页可跳转到示例页，示例页支持返回上一页和回首页。</view>
  </view>
</scroll-view>