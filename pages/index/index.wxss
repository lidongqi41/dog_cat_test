/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 48rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
}

.hero {
  padding: 16rpx 0 48rpx;
}

.hero__title {
  font-size: 48rpx;
  font-weight: 600;
  color: #111;
}

.hero__desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #888;
}

.card {
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
}

.card__title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.row__key {
  color: #888;
}

.row__value {
  color: #111;
}

.btn {
  margin-top: 48rpx;
  border: none;
  border-radius: 999rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
}

.btn::after {
  border: none;
}

.btn--active {
  opacity: 0.8;
}

.tip {
  margin-top: 32rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
}