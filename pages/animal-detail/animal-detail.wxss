.cover {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  margin-bottom: 24rpx;
  background: #eef1f4;
  border-radius: 20rpx;
  overflow: hidden;
}

.cover__img {
  width: 100%;
  height: 420rpx;
}

.cover__emoji {
  font-size: 160rpx;
}

.detail__name {
  font-size: 40rpx;
  font-weight: 600;
  color: #111111;
}

.story {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333333;
}