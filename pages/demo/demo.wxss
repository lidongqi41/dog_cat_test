/**demo.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 48rpx 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111;
}

.desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #555;
}

.tip {
  margin-top: 40rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
}