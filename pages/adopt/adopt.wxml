<navigation-bar title="领养申请" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-scroll" scroll-y type="list">
  <view class="container">
    <page-state wx:if="{{loading && !animal}}" status="loading"></page-state>

    <page-state
      wx:elif="{{error}}"
      status="error"
      text="{{error}}"
      bind:retry="loadAnimal"
    ></page-state>

    <block wx:elif="{{animal}}">
      <view class="card summary">
        <view class="summary__cover">
          <image wx:if="{{animal.cover}}" class="summary__img" src="{{animal.cover}}" mode="aspectFill"></image>
          <text wx:else class="summary__emoji">{{animal.type === 'cat' ? '🐱' : '🐶'}}</text>
        </view>
        <view class="summary__info">
          <view class="summary__name">{{animal.name}}</view>
          <view class="summary__meta">{{animal.breed}} · {{animal.age}} · {{animal.genderLabel}}</view>
          <text class="tag tag--{{animal.statusColor}}">{{animal.statusLabel}}</text>
        </view>
      </view>

      <view class="card">
        <view class="card__title">申请人信息</view>

        <view class="field">
          <view class="field__label">称呼 *</view>
          <input
            class="field__input"
            value="{{applicantName}}"
            placeholder="怎么称呼你"
            data-field="applicantName"
            bindinput="onInput"
          />
        </view>

        <view class="field">
          <view class="field__label">手机号</view>
          <input
            class="field__input"
            value="{{phone}}"
            type="number"
            maxlength="11"
            placeholder="手机号和微信号至少填一个"
            data-field="phone"
            bindinput="onInput"
          />
        </view>

        <view class="field">
          <view class="field__label">微信号</view>
          <input
            class="field__input"
            value="{{wechat}}"
            placeholder="方便工作人员联系"
            data-field="wechat"
            bindinput="onInput"
          />
        </view>

        <view class="field">
          <view class="field__label">居住情况 *</view>
          <input
            class="field__input"
            value="{{housing}}"
            placeholder="如：自有住房 / 整租一居室"
            data-field="housing"
            bindinput="onInput"
          />
        </view>

        <view class="field">
          <view class="field__label">养宠经验</view>
          <textarea
            class="field__textarea"
            value="{{experience}}"
            placeholder="以前养过什么动物，目前家里有几只宠物"
            data-field="experience"
            bindinput="onInput"
          ></textarea>
        </view>
      </view>

      <view class="card">
        <view class="checkbox" bindtap="toggleAgree">
          <view class="checkbox__box {{agreed ? 'checkbox__box--on' : ''}}">{{agreed ? '✓' : ''}}</view>
          <text class="checkbox__text">我已阅读并同意</text>
          <text class="checkbox__link" catchtap="openRule">《领养须知》</text>
        </view>
        <view class="tip">提交后可在「我的 - 我的申请」查看审核进度。平台不收取任何领养费用。</view>
      </view>

      <button
        class="btn {{animal.status !== 'available' ? 'btn--disabled' : ''}}"
        bindtap="submit"
        loading="{{submitting}}"
        disabled="{{animal.status !== 'available'}}"
      >{{animal.status === 'available' ? '提交申请' : animal.statusLabel}}</button>
    </block>
  </view>
</scroll-view>